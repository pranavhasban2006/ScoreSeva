# ScoreSeva Backend Environment Variables - Example

APP_NAME=ScoreSeva API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Model paths (relative to backend/)
XGBOOST_MODEL_PATH=saved_models/xgboost_scorer.pkl
FEATURE_COLS_PATH=saved_models/feature_columns.pkl
LABEL_ENCODERS_PATH=saved_models/label_encoders.pkl
NLP_MODEL_PATH=saved_models/nlp_psychometric.pkl
FRAUD_MODEL_PATH=saved_models/fraud_detector.pkl
TRAJECTORY_MODEL_PATH=saved_models/trajectory_predictor.pkl

# CORS origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
